NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
ANTHROPIC_API_KEY=your-anthropic-api-key
TAVILY_API_KEY=your-tavily-api-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gmail integration (Google Cloud OAuth client with the Gmail API enabled)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# 32 random bytes, base64 — generate with: openssl rand -base64 32
# Back this key up: rotating it makes every stored integration secret unreadable.
INTEGRATION_TOKEN_KEY=your-32-byte-base64-key
# Every Gmail action except Send needs a RESTRICTED scope and stays OFF unless
# this is exactly "true". Create Draft is included: gmail.compose is restricted
# (A15), so it is gated with Find/Read/Reply, not with Send. Leave this false in
# any environment where Google restricted-scope verification is not complete.
GMAIL_READ_ACTIONS_ENABLED=false

# Local Inngest dev server (npx inngest-cli dev). Unset in production, where the
# two keys below are used instead.
INNGEST_DEV=1

# A10 — the two Inngest keys are NOT interchangeable, and confusing them is the
# reason this section exists. Both must be set in production.
#
#   INNGEST_SIGNING_KEY  Inngest -> your app. Authenticates the serve endpoint
#                        at app/api/inngest/route.ts, which is the only route
#                        with no session check. If it is unset, that endpoint
#                        accepts UNSIGNED requests into runScheduledWorkflow,
#                        which runs with the service-role admin client — a
#                        forged workflow/schedule.due event could trigger other
#                        users workflows, Gmail sends included. The failure is
#                        SILENT: nothing looks broken. This is the key the
#                        unsigned-POST production test exercises.
#
#   INNGEST_EVENT_KEY    Your app -> Inngest. Authenticates event publishing
#                        (checkDueSchedules and the per-schedule Run now route).
#                        If it is unset the failure is LOUD: schedules never
#                        fire and Run now breaks, so you notice immediately.
#                        A passing unsigned-POST test says NOTHING about it —
#                        verify it separately with Run now.
INNGEST_SIGNING_KEY=signkey-prod-...
INNGEST_EVENT_KEY=your-inngest-event-key

# Task 02 error reporter. The vendor and DSN are an operator decision; register
# the transport through setErrorTransport() in lib/observability/report.ts.
# Until one is set, reportError() still writes a structured stderr line.
# ERROR_REPORTER_DSN=
