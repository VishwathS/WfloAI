NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
ANTHROPIC_API_KEY=your-anthropic-api-key
TAVILY_API_KEY=your-tavily-api-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gmail integration (Google Cloud OAuth client with the Gmail API enabled)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# 32 random bytes, base64 — generate with: openssl rand -base64 32
# Back this key up: rotating it makes every stored integration secret unreadable.
INTEGRATION_TOKEN_KEY=your-32-byte-base64-key
# Gmail Find/Read/Reply require the RESTRICTED gmail.readonly scope and stay
# OFF unless this is exactly "true". Leave it false in any environment where
# Google restricted-scope verification is not yet complete; Send and Create
# Draft need only sensitive scopes and remain available either way.
GMAIL_READ_ACTIONS_ENABLED=false

# Local Inngest dev server (npx inngest-cli dev). Unset in production, where
# INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY are used instead.
INNGEST_DEV=1
